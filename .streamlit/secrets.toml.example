# Local use: copy this file to .streamlit/secrets.toml (gitignored) and fill it in.
# Streamlit Community Cloud: paste the same contents into Settings -> Secrets.

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional overrides (defaults are in .env.example). Values may be strings.
# CLAUDE_MODEL = "claude-sonnet-5"
# TOP_K = "4"
# CHUNK_SIZE = "800"
# CHUNK_OVERLAP = "150"

# Cost / abuse guardrails (see README "Cost & abuse controls")
# APP_PASSWORD = "share-this-with-reviewers"
# RATE_LIMIT_PER_HOUR = "20"
# MAX_MESSAGES_PER_SESSION = "20"
# MAX_QUESTION_CHARS = "600"
# HISTORY_TURNS = "3"
# MAX_TOKENS = "768"
